#include "common_keymap.dtsi"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define DEFAULT_L 0
#define SYMBOLS_L 1
#define ARROWS_L  2
#define NUMBERS_L 3

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <300>;
            quick-tap-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        symbol_return: symbol_return {
            compatible = "zmk,behavior-tap-dance";
            label = "SYMBOL_RETURN";
            #binding-cells = <0>;
            bindings = <&mo 1>, <&kp ENTER>;
        };

        DANG_HRM: DANG_HRM {
            compatible = "zmk,behavior-hold-tap";
            label = "DANG_HRM";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            hold-while-undecided;
            flavor = "tap-preferred";
        };
    };

    combos {
        compatible = "zmk,combos";

        single_quote {
            bindings = <&kp SINGLE_QUOTE>;
            key-positions = <19 20>;
        };

        double_quote {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <7 8>;
        };

        escape {
            bindings = <&kp ESC>;
            key-positions = <15 14>;
        };

        grave {
            bindings = <&kp GRAVE>;
            key-positions = <15 16>;
        };

        tilde {
            bindings = <&kp TILDE>;
            key-positions = <3 4>;
        };

        caps_word {
            bindings = <&caps_word>;
            key-positions = <26 27>;
        };

        Homerow {
            bindings = <&kp LS(LG(SPACE))>;
            key-positions = <21 20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "DEF";
            bindings = <
&none  &kp Q                     &kp W                 &kp E                   &kp R                 &kp T        &kp Y           &kp U                  &kp I                    &kp O                  &kp P                      &none
&none  &DANG_HRM LEFT_CONTROL A  &DANG_HRM LEFT_ALT S  &DANG_HRM LEFT_SHIFT D  &DANG_HRM LEFT_GUI F  &kp G        &kp H           &DANG_HRM RIGHT_GUI J  &DANG_HRM RIGHT_SHIFT K  &DANG_HRM RIGHT_ALT L  &DANG_HRM RCTRL SEMICOLON  &none
&none  &kp Z                     &kp X                 &kp C                   &kp V                 &kp B        &kp N           &kp M                  &kp COMMA                &kp DOT                &kp SLASH                  &none
                                                       &none                   &lt 2 TAB             &kp SPACE    &symbol_return  &kp BACKSPACE          &none
            >;
        };

        symbols_layer {
            label = "SYMB";
            bindings = <
&trans  &kp PERCENT  &kp N7        &kp N8        &kp N9        &kp AT_SIGN    &kp EXCLAMATION  &kp AMPERSAND  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp ASTERISK   &trans
&trans  &kp N0       &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp HASH       &kp MINUS        &kp EQUAL      &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp PIPE       &trans
&trans  &kp CARET    &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp DOLLAR     &kp UNDERSCORE   &kp PLUS       &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp BACKSLASH  &trans
                                   &trans        &trans        &trans         &trans           &trans         &trans
            >;
        };

        navigation {
            bindings = <
&trans  &trans  &trans    &kp UP_ARROW    &trans     &trans    &trans          &trans          &trans        &trans     &trans  &trans
&trans  &trans  &kp LEFT  &kp DOWN_ARROW  &kp RIGHT  &trans    &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT  &trans  &trans
&trans  &trans  &trans    &trans          &trans     &trans    &trans          &trans          &trans        &trans     &trans  &trans
                          &trans          &trans     &trans    &kp ENTER       &mo 3           &trans
            >;
        };

        FNC {
            label = "NAV";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &bt BT_SEL 0    &bt BT_SEL 3  &kp C_PP    &kp C_PREV         &kp C_NEXT            &trans  &trans
&none   &trans  &trans  &trans  &trans  &bt BT_SEL 1    &bt BT_SEL 4  &kp K_MUTE  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP       &trans  &trans
&trans  &trans  &trans  &trans  &trans  &bt BT_SEL 2    &bt BT_CLR    &kp CAPS    &kp C_BRI_DEC      &kp C_BRIGHTNESS_INC  &trans  &trans
                        &trans  &trans  &trans          &kp ENTER     &trans      &trans
            >;
        };

        numbers_layer {
            label = "NUM";
            bindings = <
&kp ESC  &kp F1  &kp F2  &kp F3        &kp F4     &kp F5       &kp F6  &kp F7     &kp F8  &kp F9  &kp F10  &kp F11
&none    &none   &none   &none         &trans     &trans       &trans  &trans     &trans  &trans  &trans   &kp RET
&kp TAB  &none   &none   &none         &kp FSLH   &kp MINUS    &trans  &trans     &trans  &trans  &trans   &to 5
                         &kp LEFT_ALT  &kp LSHFT  &mo 0        &mo 2   &kp SPACE  &none
            >;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };
    };
};
